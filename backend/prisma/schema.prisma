generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  TRAINER
  STUDENT
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum StudentStatus {
  INVITED
  ACTIVE
  PAUSED
  INACTIVE
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String?
  role               UserRole
  status             UserStatus @default(INVITED)
  emailVerifiedAt    DateTime?
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  trainer Trainer?
  student Student?
}

model Trainer {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  students        Student[]
  sentInvitations AccountInvitation[] @relation("TrainerSentInvitations")
  plans           Plan[]
  subscriptions   Subscription[]
  payments        Payment[]
  installments    Installment[]
  exercises       Exercise[]
  routines        Routine[]
}

model Student {
  id          String        @id @default(cuid())
  trainerId   String
  userId      String?       @unique
  email       String
  dni         String
  firstName   String
  lastName    String
  phone       String?
  status      StudentStatus @default(INVITED)
  invitedAt   DateTime?
  activatedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  trainer            Trainer             @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  accountInvitations AccountInvitation[]
  subscriptions      Subscription[]
  studentRoutines    StudentRoutine[]

  @@index([trainerId])
  @@index([email])
}

model AccountInvitation {
  id                 String    @id @default(cuid())
  studentId          String
  email              String
  tokenHash          String
  expiresAt          DateTime
  usedAt             DateTime?
  createdByTrainerId String
  createdAt          DateTime  @default(now())

  student          Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdByTrainer Trainer @relation("TrainerSentInvitations", fields: [createdByTrainerId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([email])
  @@index([createdByTrainerId])
}

enum PlanDuration {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Plan {
  id          String       @id @default(cuid())
  trainerId   String
  name        String
  description String?
  price       Decimal      @db.Decimal(10, 2)
  duration    PlanDuration
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  trainer       Trainer        @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([trainerId])
}

model Subscription {
  id          String             @id @default(cuid())
  studentId   String
  planId      String
  trainerId   String
  status           SubscriptionStatus @default(ACTIVE)
  startDate        DateTime
  endDate          DateTime
  totalAmount      Decimal            @db.Decimal(10, 2)
  installmentCount Int                @default(1)
  frequency        PaymentFrequency   @default(MONTHLY)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  trainer      Trainer       @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  payments     Payment[]
  installments Installment[]

  @@index([studentId])
  @@index([planId])
  @@index([trainerId])
  @@index([endDate])
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  trainerId      String
  amount         Decimal      @db.Decimal(10, 2)
  paidAt         DateTime     @default(now())
  periodLabel    String
  notes          String?
  createdAt      DateTime     @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  trainer      Trainer      @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([trainerId])
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentFrequency {
  BIWEEKLY
  MONTHLY
}

model Installment {
  id             String            @id @default(cuid())
  subscriptionId String
  trainerId      String
  number         Int
  amount         Decimal           @db.Decimal(10, 2)
  dueDate        DateTime
  paidAt         DateTime?
  status         InstallmentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  trainer      Trainer      @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([trainerId])
  @@index([dueDate])
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MovementType {
  PUSH
  PULL
  HINGE
  SQUAT
  CARRY
  CORE
  CARDIO
  OLYMPIC
}

enum MediaType {
  GIF
  YOUTUBE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model MuscleGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  exercises Exercise[]
}

model Equipment {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  exercises Exercise[]
}

model Exercise {
  id            String       @id @default(cuid())
  name          String
  description   String?
  muscleGroupId String
  difficulty    Difficulty   @default(BEGINNER)
  movementType  MovementType
  equipmentId   String?
  mediaUrl      String?
  mediaType     MediaType?
  isGlobal      Boolean      @default(false)
  trainerId     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  muscleGroup      MuscleGroup       @relation(fields: [muscleGroupId], references: [id])
  equipment        Equipment?        @relation(fields: [equipmentId], references: [id])
  trainer          Trainer?          @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  routineExercises RoutineExercise[]

  @@index([muscleGroupId])
  @@index([trainerId])
  @@index([isGlobal])
}

model Routine {
  id          String   @id @default(cuid())
  name        String
  description String?
  isGlobal    Boolean  @default(false)
  trainerId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainer          Trainer?          @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  routineExercises RoutineExercise[]
  studentRoutines  StudentRoutine[]

  @@index([trainerId])
  @@index([isGlobal])
}

model RoutineExercise {
  id              String    @id @default(cuid())
  routineId       String
  exerciseId      String
  dayOfWeek       DayOfWeek
  order           Int
  sets            Int
  reps            String
  suggestedWeight Float?
  suggestedRpe    Float?
  restSeconds     Int       @default(90)
  notes           String?

  routine         Routine                  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise        Exercise                 @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  workoutSets     WorkoutSet[]
  weeklyOverrides WeeklyExerciseOverride[]

  @@index([routineId])
  @@index([exerciseId])
  @@index([dayOfWeek])
}

model StudentRoutine {
  id         String    @id @default(cuid())
  studentId  String
  routineId  String
  isActive   Boolean   @default(true)
  assignedAt DateTime  @default(now())
  notes      String?
  weekNumber Int       @default(1)
  startDate  DateTime?
  endDate    DateTime?

  student         Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routine         Routine                  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  workoutLogs     WorkoutLog[]
  weeklyOverrides WeeklyExerciseOverride[]

  @@index([studentId])
  @@index([routineId])
}

model WeeklyExerciseOverride {
  id                String   @id @default(cuid())
  studentRoutineId  String
  routineExerciseId String
  weekNumber        Int
  suggestedWeight   Float?
  suggestedReps     String?
  suggestedRpe      Float?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  studentRoutine  StudentRoutine  @relation(fields: [studentRoutineId], references: [id], onDelete: Cascade)
  routineExercise RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)

  @@unique([studentRoutineId, routineExerciseId, weekNumber])
  @@index([studentRoutineId])
  @@index([weekNumber])
}

model WorkoutLog {
  id               String   @id @default(cuid())
  studentRoutineId String
  date             DateTime @default(now())
  notes            String?
  createdAt        DateTime @default(now())

  studentRoutine StudentRoutine @relation(fields: [studentRoutineId], references: [id], onDelete: Cascade)
  workoutSets    WorkoutSet[]

  @@index([studentRoutineId])
  @@index([date])
}

model WorkoutSet {
  id                String   @id @default(cuid())
  workoutLogId      String
  routineExerciseId String
  setNumber         Int
  reps              Int
  weight            Float?
  rpe               Float?
  notes             String?
  createdAt         DateTime @default(now())

  workoutLog      WorkoutLog      @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  routineExercise RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutLogId])
  @@index([routineExerciseId])
}
