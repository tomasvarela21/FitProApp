# ─── Database ────────────────────────────────────────────────────────────────
# Supabase connection string (via pgBouncer for serverless)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (used by Prisma Migrate)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
# Public URL of the frontend (used in email links)
APP_URL="http://localhost:5173"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Push Notifications (Web Push / VAPID) ───────────────────────────────────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:noreply@yourdomain.com"

# ─── Cron & Admin ─────────────────────────────────────────────────────────────
# Secret for manually triggering the cron job via POST /api/run-alerts
CRON_SECRET="change-me"
# Secret for admin-only endpoints
ADMIN_SECRET="change-me"

# ─── Telegram Agent (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_MODE="polling"           # "polling" (dev) | "webhook" (prod)
TELEGRAM_WEBHOOK_SECRET=""        # Required when TELEGRAM_MODE=webhook
PUBLIC_URL=""                     # Public URL for webhook registration

# ─── Gemini AI (optional, required for Telegram agent) ────────────────────────
GEMINI_API_KEY=""
AGENT_MODEL="gemini-2.5-flash"
