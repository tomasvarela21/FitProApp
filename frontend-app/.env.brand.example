# ─────────────────────────────────────────────────────────────────────────────
# FitProApp — Variables de marca white-label
# ─────────────────────────────────────────────────────────────────────────────
# Todas son opcionales. Si no se definen, la app usa el diseño KOREX por default.
#
# CÓMO USAR LOCALMENTE
#   Copiar las vars que querés probar a .env.local (ya está en .gitignore).
#   Vite lo carga automáticamente sin ningún flag extra.
#
# EN PRODUCCIÓN (Vercel)
#   Cada cliente tiene su propio Vercel Project con estas vars en:
#   Settings → Environment Variables → Production
#   El repo de GitHub es el mismo para todos los proyectos.
# ─────────────────────────────────────────────────────────────────────────────

# Identidad
VITE_BRAND_NAME="KOREX"                   # Nombre de la app / pestaña del browser
VITE_BRAND_TRAINER_NAME="KOREX Team"      # Nombre del entrenador en sidebar y login

# Assets (paths relativos a /public)
VITE_BRAND_LOGO_PATH="/korex-isotipo.svg"
VITE_BRAND_FAVICON_PATH="/korex-icon.png"
VITE_BRAND_TRAINER_PHOTO=""               # Dejar vacío si no hay foto

# Colores (hex). Si no se definen, se usan los tokens oklch del CSS.
# IMPORTANTE: los valores hex van siempre entre comillas — el # sin comillas
# es interpretado como comentario por dotenv y la variable queda vacía.
VITE_BRAND_PRIMARY="#f0c428"              # Color de acento: botones, sidebar activo, rings
VITE_BRAND_PRIMARY_FG="#0e0c08"          # Texto sobre el color de acento
VITE_BRAND_BG="#0e0c08"                  # Fondo base (dark)
VITE_BRAND_SURFACE="#1a1714"             # Cards, sidebar, popovers

# Tipografía
VITE_BRAND_FONT_HEADING="Syne"           # Fuente para h1–h6
VITE_BRAND_FONT_BODY="Space Grotesk"     # Fuente para body text

# Google Fonts — URL completa (dejar vacío si se usan las fuentes base del CSS)
# Ejemplo con fuentes custom:
# VITE_BRAND_GOOGLE_FONTS="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap"
VITE_BRAND_GOOGLE_FONTS=""
